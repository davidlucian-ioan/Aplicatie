{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "npm test"
  },
  "coverageAnalysis": "off",
  "mutate": [
    "engine.js"
  ],
  "concurrency": 4,
  "timeoutMS": 10000,
  "timeoutFactor": 1.5,
  "reporters": [
    "clear-text",
    "html",
    "json"
  ],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 0
  },
  "htmlReporter": {
    "fileName": "reports/mutation/mutation.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  }
}
