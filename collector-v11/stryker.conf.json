{
  "testRunner": "command",
  "commandRunner": {
    "command": "npm test && npm run test:properties && npm run test:core-properties"
  },
  "coverageAnalysis": "off",
  "mutate": [
    "engine.js"
  ],
  "reporters": [
    "clear-text",
    "progress",
    "html",
    "json"
  ],
  "htmlReporter": {
    "fileName": "test-results/mutation/mutation.html"
  },
  "jsonReporter": {
    "fileName": "test-results/mutation/mutation.json"
  },
  "concurrency": 2,
  "timeoutMS": 15000,
  "timeoutFactor": 3,
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  }
}
