{
  "name": "collector-mvp",
  "version": "0.11.1-ai-foundation.2",
  "private": true,
  "description": "Collector MVP with an isolated AI Foundation scaffold",
  "scripts": {
    "test": "node --test test-*.js",
    "test:properties": "node --test property-stock-sequences.test.js",
    "test:e2e": "playwright test --project=chromium",
    "test:ui-coverage": "playwright test --project=chromium e2e/app-ui-coverage.spec.cjs",
    "test:all": "npm test && npm run test:properties && npm run test:core-properties && npm run test:coverage && npm run benchmark:replay && npm run test:e2e",
    "test:core-properties": "node --test property-core-sequences.test.js",
    "test:coverage": "node --experimental-test-coverage --test test-*.js property-*.test.js",
    "benchmark:replay": "node benchmark-replay.js",
    "start": "node server.js",
    "mobile:build": "node build-mobile.js",
    "mobile:sync": "npm run mobile:build && npx cap sync",
    "mobile:configure": "node configure-native-projects.js"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "fast-check": "4.11.0"
  }
}
