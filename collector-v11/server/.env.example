# Copy values into the server process environment; do not commit real secrets.
OPENAI_API_KEY=replace-with-server-side-openai-api-key
OPENAI_MODEL=choose-a-supported-model
COLLECTOR_AI_GATEWAY_TOKEN=replace-with-at-least-24-random-characters
COLLECTOR_ALLOWED_ORIGINS=https://your-collector-app.example
COLLECTOR_AI_RATE_LIMIT=30
PORT=8787

# The app must obtain a short-lived access token from an authentication system.
# Never embed COLLECTOR_AI_GATEWAY_TOKEN or OPENAI_API_KEY in the Android APK or web bundle.
